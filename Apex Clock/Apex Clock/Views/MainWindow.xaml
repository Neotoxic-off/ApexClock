<ui:FluentWindow x:Class="Apex_Clock.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Apex_Clock.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="Apex Clock"
                 Width="320" SizeToContent="Height"
                 ResizeMode="CanMinimize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/ApexClock;component/Assets/AppIcon.ico"
                 WindowStartupLocation="CenterScreen">
    <StackPanel>
        <ui:TitleBar Title="Apex Clock" ShowMaximize="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/ApexClock;component/Assets/AppIcon.png" Width="16" Height="16" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <ToggleButton ToolTip="Always on top" Padding="6" Margin="0,0,2,0" BorderThickness="0"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:SymbolIcon Symbol="Pin20" />
                    </ToggleButton>
                    <ui:Button Style="{StaticResource IconButton}" ToolTip="Settings"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Command="{Binding OpenSettingsCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Settings20" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <StackPanel Margin="12,0,12,12" DataContext="{Binding Live}" d:DataContext="{d:DesignInstance Type=vm:LiveRotationViewModel}">
            <!-- Current map -->
            <Border CornerRadius="10" Height="124" ClipToBounds="True"
                    Background="{Binding CurrentMap, Converter={StaticResource MapArtworkRight}}">
                <Grid>
                    <!-- Legibility scrim behind the text at the bottom -->
                    <Border CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#20000000" Offset="0" />
                                <GradientStop Color="#D0000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="14,10,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border HorizontalAlignment="Left" CornerRadius="8" Padding="8,2" Background="#40000000">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding CurrentMap}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                       Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="#CCFFFFFF" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Countdown}" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Light"
                                   Foreground="White" Typography.NumeralAlignment="Tabular" ToolTip="{Binding Remaining}" />

                        <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Height="3" Minimum="0" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" Foreground="White" Background="#33FFFFFF" BorderThickness="0" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Up next -->
            <TextBlock Text="UP NEXT" FontSize="11" FontWeight="SemiBold" Margin="2,12,0,4"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ItemsControl ItemsSource="{Binding Upcoming}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:UpcomingSlotViewModel}">
                        <Grid Margin="0,3" ToolTip="{Binding TimeRange}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="20" Margin="0,0,10,0" CornerRadius="4"
                                    Background="{Binding Map, Converter={StaticResource MapArtwork}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Map}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding StartsIn}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
