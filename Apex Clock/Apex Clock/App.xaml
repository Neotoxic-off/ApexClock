<Application x:Class="Apex_Clock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Apex_Clock.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <converters:MapBrushConverter x:Key="MapArtwork" />
            <converters:MapBrushConverter x:Key="MapArtworkRight" AlignmentX="Right" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
